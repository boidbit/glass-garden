; Glass Run — a Smash Hit style glass run, made with Godot 4.3.

config_version=5

[application]

config/name="Glass Run"
config/description="Break the glass. Keep moving."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.043, 0.059, 0.086, 1)
boot_splash/show_image=true
boot_splash/image="res://splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
run/max_fps=60

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.039, 0.055, 0.078, 1)
textures/vram_compression/import_etc2_astc=true
