; Glass Rush — an endless flight through the glass worlds of Glass Run, made with Godot 4.7.

config_version=5

[application]

config/name="Glass Rush"
config/description="Fly fast. Smash the thin glass. Miss the thick."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.039, 0.024, 0.078, 1)
boot_splash/show_image=false
run/max_fps=60
config/quit_on_go_back=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.039, 0.024, 0.078, 1)
textures/vram_compression/import_etc2_astc=true
